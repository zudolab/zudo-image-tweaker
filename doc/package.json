{
  "name": "doc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "zfb dev",
    "build": "zfb build",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:links": "node scripts/check-links.js --strict-broken --strict-anchors",
    "check:examples": "tsc --noEmit -p examples-check/tsconfig.json",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh",
    "setup:doc-skill-silent": "bash scripts/setup-doc-skill.sh --silent",
    "setup:doc-skill:claude": "bash scripts/setup-doc-skill.sh --target claude",
    "setup:doc-skill:codex": "bash scripts/setup-doc-skill.sh --target codex",
    "setup:doc-skill:both": "bash scripts/setup-doc-skill.sh --target both",
    "b4push": "pnpm check && pnpm build && pnpm check:links"
  },
  "dependencies": {
    "@takazudo/zfb": "5.1.2",
    "@takazudo/zfb-runtime": "5.1.2",
    "@takazudo/zfb-md-wasm": "5.1.2",
    "@takazudo/zudo-doc": "^8.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "wrangler": "4.152.0"
  }
}
